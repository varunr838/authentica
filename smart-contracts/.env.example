# ============================================================
#  Authentica Smart Contracts — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit your actual .env to git.
# ============================================================

# Your deployer wallet private key (without 0x prefix is also fine)
# Get a test wallet from MetaMask — never use your main wallet here
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Sepolia RPC endpoint — get a free one from:
#   https://www.alchemy.com   or   https://www.infura.io
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Polygon Amoy (optional alternative testnet)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Etherscan API key — for contract verification on explorer
# https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Set to "true" to get gas cost reports after tests
REPORT_GAS=false

# CoinMarketCap key for USD gas estimates (optional)
COINMARKETCAP_API_KEY=
