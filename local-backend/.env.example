# ============================================================
#  Authentica — Local Backend Environment Variables
#  Copy this file to .env and fill in real values.
# ============================================================

# ── Blockchain ────────────────────────────────────────────────────────────────
# Ethereum RPC endpoint (Alchemy / Infura / local Hardhat node)
WEB3_RPC_URL=http://127.0.0.1:8545

# Deployer / publisher private key (without 0x prefix is also fine)
# NEVER commit a real funded key here.
PUBLISHER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Chain ID: 1337 = local Hardhat, 11155111 = Sepolia
CHAIN_ID=1337

# Network name — must match a key in smart-contracts/deployments/<name>.json
NETWORK_NAME=localhost

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── zkML Engine ───────────────────────────────────────────────────────────────
# Absolute or relative path to the zkml-engine directory
ZKML_ENGINE_DIR=../zkml-engine

# ── Smart contracts ───────────────────────────────────────────────────────────
# Absolute or relative path to the smart-contracts directory
CONTRACTS_DIR=../smart-contracts

# ── Optional: Gas settings (leave blank for auto) ─────────────────────────────
GAS_LIMIT=800000
MAX_FEE_GWEI=
PRIORITY_FEE_GWEI=
